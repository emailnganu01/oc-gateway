# opencode-gateway env vars (semua opsional)

# Port listen (default 20128). Railway akan set PORT sendiri.
PORT=20128

# Kalau diisi, semua request wajib punya header: Authorization: Bearer <GATEWAY_KEY>
GATEWAY_KEY=

# fresh  = ses_ baru tiap request (default — hindari limit per-session)
# stable = ses_ sama per percakapan (prompt-cache, tapi kuota session sama)
# client = pakai x-opencode-session dari client bila ada
SESSION_MODE=fresh

# keep     = teruskan User-Agent opencode CLI asli bila mengandung "opencode" (default)
# opencode = paksa "opencode"
FORWARD_UA=keep

# Alias model: JSON map alias → model asli. telur-ceplok sudah ada sebagai default.
# MODEL_ALIASES={"telur-ceplok":"deepseek-v4-flash-free","mimo":"mimo-v2.5-free"}
